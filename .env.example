# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# M1: from https://explore.openaq.org -> sign in -> Account -> API key
OPENAQ_API_KEY=paste-your-key-here

# M2: MySQL 8 connection (matches the docker run command in README.md; 3307 because 3306 was taken)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=eightpm
MYSQL_USER=eightpm
MYSQL_PASSWORD=choose-a-password

# Study settings (change only after the team agrees in M5)
CITY=Bengaluru
DATE_START=2025-10-01
DATE_END=2026-11-20
